#include <metal_stdlib>
#include <RealityKit/RealityKit.h>
using namespace metal;

// Shared look for everything generated by BikeinsideCore: colour comes from the
// vertex colour (authored in sRGB), lighting is RealityKit's PBR, and distance
// fog blends towards the horizon colour.
// custom_parameter: rgb = fog colour (linear), a = fog end distance (metres).

static void bikeinsideShade(realitykit::surface_parameters params, half roughness, half specular)
{
    half3 srgb = params.geometry().color().rgb;
    half3 base = pow(max(srgb, half3(0.0h)), half3(2.2h));

    float4 fog = params.uniforms().custom_parameter();
    float3 world = params.geometry().world_position();
    float3 view = (params.uniforms().world_to_view() * float4(world, 1.0)).xyz;
    float d = length(view);
    float f = smoothstep(fog.w * 0.15, fog.w, d);
    f = f * (2.0 - f); // ease out: thicker haze towards the horizon
    half hf = half(clamp(f, 0.0, 1.0));

    params.surface().set_base_color(base * (1.0h - hf));
    params.surface().set_emissive_color(half3(fog.rgb) * hf);
    params.surface().set_roughness(roughness);
    params.surface().set_metallic(0.0h);
    params.surface().set_specular(specular * (1.0h - hf));
}

[[visible]]
void bikeinsideSurface(realitykit::surface_parameters params)
{
    bikeinsideShade(params, 0.88h, 0.25h);
}

[[visible]]
void bikeinsideWater(realitykit::surface_parameters params)
{
    bikeinsideShade(params, 0.10h, 0.9h);
}
